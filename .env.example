# Public URL of the app (used for payment callbacks and email links)
APP_URL=http://localhost:3000
# Where the SQLite file lives
DATABASE_PATH=./data/tasaddur.db
# Moyasar keys (https://dashboard.moyasar.com) - test keys start with pk_test_ / sk_test_
MOYASAR_PUBLISHABLE_KEY=pk_test_xxx
MOYASAR_SECRET_KEY=sk_test_xxx
# Protects the weekly re-check endpoint: call GET /api/cron/weekly with header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# Optional: Resend API key for alert emails (logs to console when empty)
RESEND_API_KEY=
EMAIL_FROM=Tasaddur <alerts@example.com>
# Development only: allow auditing localhost/private IPs (never set in production)
ALLOW_PRIVATE_HOSTS=
# Moyasar webhook (Dashboard > Webhooks, URL <APP_URL>/api/payments/webhook, event payment_paid): the secret token you set there
MOYASAR_WEBHOOK_SECRET=
# Number of trusted reverse proxies in front of the app (Render = 1). Used to read the real client IP from X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Optional: VAT registration number printed on receipts
VAT_NUMBER=
# Optional: footer contact link (WhatsApp number in international format, or an email)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
# Tuning: domains re-audited per cron call, and audits allowed to run at once
CRON_BATCH=20
MAX_CONCURRENT_AUDITS=3
